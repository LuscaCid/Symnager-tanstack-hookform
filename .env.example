# Copie para .env e ajuste. Usado pelo docker-compose.yml.

# OBRIGATÓRIO: segredo de assinatura dos tokens (mínimo 32 caracteres).
# Gere com:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Porta publicada do site
WEB_PORT=8080

# Endereços (origens) que podem chamar a API diretamente, separados por vírgula.
# Inclua app://symnager se computadores com o app desktop forem usar este servidor.
CORS_ORIGINS=http://localhost:8080,app://symnager

# true quando o site for servido por HTTPS (cookie de sessão "Secure")
COOKIE_SECURE=false

JWT_EXPIRES_IN=15m
REFRESH_TTL_DAYS=30

# Caminho do repositório da API (padrão: pasta irmã)
# SYMNAGER_API_DIR=../Symnager-nest-prisma

# Somente para "npm run dev" (Vite): para onde o proxy /api aponta
# VITE_DEV_API=http://127.0.0.1:3333
